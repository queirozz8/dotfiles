/* ROFI VERTICAL THEME USING THE DARKMATTER PALETTE */
/* Same layout as Nordic/Nord community themes; palette from ../README.md */

* {
    font:   "JetBrains Mono 12";

    dm-shadow:      #060506;
    dm-dark:        #121113;
    dm-bg:          #121113;
    dm-sidebar:     #171618;
    dm-base:        #1c1b1d;
    dm-hover:       #222222;
    dm-border:      #2b2b2b;
    dm-border-hi:   #333333;

    dm-dim:         #888888;
    dm-muted:       #999999;
    dm-soft:        #aaaaaa;
    dm-subtle:      #c1c1c1;
    dm-fg:          #ffffff;

    dm-teal:        #5f8787;
    dm-cream:       #fbcb97;
    dm-orange:      #e78a53;
    dm-red:         #e75353;

    background-color:   transparent;
    text-color:         @dm-subtle;
    accent-color:       @dm-orange;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    background-color:   @dm-bg;
    border-color:       @dm-border;

    location:   center;
    width:      480px;
    border:     1px;
    border-radius: 12px;
}

inputbar {
    border-radius: 9px;
    background-color: @dm-base;
    padding:    10px 14px;
    spacing:    12px;
    children:   [ prompt, entry ];
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    text-color: @accent-color;
}

listview {
    lines:      8;
    columns:    1;

    fixed-height:   false;
    dynamic:        true;
    spacing:        3px;
}

element {
    border-radius: 7px;
    padding:    10px;
    spacing:    10px;
}

element normal urgent {
    text-color: @dm-cream;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

element selected {
    text-color: @dm-bg;
}

element selected normal {
    background-color:   @accent-color;
}

element selected urgent {
    background-color:   @dm-cream;
}

element selected active {
    background-color:   @accent-color;
}

element-icon {
    size:   0.9em;
}

element-text {
    text-color: inherit;
}
